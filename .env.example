# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# --- GitHub activity section (Phase 5) -----------------------------------
# Server-only. Create a token at https://github.com/settings/tokens
# Classic token: the `read:user` scope is enough for profile stats,
# pinned repos and the contribution calendar.
GITHUB_TOKEN=

# --- Contact form (Phase 6) ----------------------------------------------
# Server-only. Without these, development logs submissions to the terminal and
# production returns 503 (the UI then points visitors to your email address).
# Resend: https://resend.com/api-keys  (free tier is enough for a portfolio)
RESEND_API_KEY=
# Where submissions are delivered. With the default onboarding@resend.dev sender
# this must be the email of your Resend account.
CONTACT_TO_EMAIL=
# Optional. Only works once you verify a domain in Resend, e.g. "Portfolio <hi@yourdomain.com>"
CONTACT_FROM_EMAIL=

# --- SEO / Open Graph (Phase 7) ------------------------------------------
# Canonical site URL, no trailing slash. On Vercel set it to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
